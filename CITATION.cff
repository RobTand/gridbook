    given-names: Robert
    email: robert.tand@icloud.com
repository-code: "https://github.com/RobTand/gridbook"
url: "https://github.com/RobTand/gridbook"
license: Apache-2.0
version: "0.8.3"
date-released: 2026-08-11
keywords:
