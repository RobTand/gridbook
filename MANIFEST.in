# Sdist contents beyond the package itself. Release artifacts are built from
# THIS canonical tree, so the sdist gets the full public README, docs, and
# roadmap alongside the runtime package.
#
# The runtime CUDA sources need no rule here: they live inside the package
# (gridbook/csrc) and are declared as [tool.setuptools.package-data] in
# pyproject.toml, which setuptools also honours when building the sdist.
#
# LICENSE / NOTICE need no rule either: setuptools' default `license-files`
# globs (LICEN[CS]E*, COPYING*, NOTICE*, AUTHORS*) put them in both the sdist
# and the wheel's .dist-info/licenses/.
include ROADMAP.md
graft docs
recursive-include tests *.py
include scripts/prepare_lfm_fused_validation.py
include scripts/validate_fused_nvfp4_ab.py
include scripts/validate_fused_nvfp4_three_arm.py
include scripts/validate_moe_persistent_b_ab.py
include scripts/validate_moe_gemv_v2_ab.py

# Developer tools that live inside the package directory but are NOT package
# data: standalone main() binaries (gridbook/csrc/tools/) that nothing loads at
# runtime. The pyproject package-data globs are single-level and therefore skip
# them, which is what keeps them out of the wheel; this rule puts them back in
# the SDIST, where the full auditable source tree belongs. Their output ships
# (the smem table baked into cb_fused_gemm.cu), the binaries do not.
recursive-include gridbook/csrc/tools *.cu

# Same deal for the pristine CUTLASS baselines the forks are diffed against
# (~67 KB). Nothing #includes them; they exist so a reviewer can see exactly
# what the fork changed. Auditability wants them in the source distribution,
# and nothing wants them in every user's site-packages. Here they must be named
# explicitly, because the package-data glob csrc/cutlass_fork/*.hpp DOES match
# them and pyproject's exclude-package-data is what takes them back out of the
# wheel.
include gridbook/csrc/cutlass_fork/*_orig.hpp

# ...but `graft docs` is indiscriminate, and two things under docs/ are internal
# working material, not documentation for someone who ran `pip install gridbook`.
# A published sdist is permanent (a PyPI file cannot be re-uploaded), so these
# are excluded at the source rather than trimmed later:
#
#   docs/DISTRIBUTION.md  the distribution decision record -- internal machine
#                         paths, internal task numbers, and a not-yet-executed
#                         launch plan. Reaches the public via the GitHub repo,
#                         which is a revisable surface; it has no business in an
#                         immutable release artifact.
#   docs/hf-cards/        staged HuggingFace card edits that have not been
#                         applied yet, each carrying its own APPLY GATE. Shipping
#                         un-applied drafts inside the wheel's own sdist invites
#                         someone to read them as the current cards.
exclude docs/DISTRIBUTION.md
prune docs/hf-cards

global-exclude *.py[cod]
